// Copy to Secrets.swift (gitignored) and fill in, or let sync-to-mac.sh generate it.
// token: the receiver's bearer token (~/.config/watch-dictate/token on the server).
// accessClient*: Cloudflare Access service token, if the server sits behind Access; else "".
enum Secrets {
    static let token = ""
    static let accessClientId = ""
    static let accessClientSecret = ""
}
