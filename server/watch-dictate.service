[Unit]
Description=watch-dictate receiver (Apple Watch dictation -> the chosen Happy or T3 chat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit: the user that runs T3 / Happy, and the paths to this checkout and Node 24.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/watch-dictate/server
# Optional overrides (WATCH_DICTATE_PUBLIC_URL, HAPPY_SERVER_URL, HAPPY_CLIENT_MODULE, ...)
EnvironmentFile=-/home/YOUR_USER/.config/watch-dictate/env
Environment=WATCH_DICTATE_PORT=8790
ExecStart=/usr/bin/env node /home/YOUR_USER/watch-dictate/server/dictate-server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
